# Read the file, skipping metadata lines until we hit the header row (the line starting with 'Time')
with open(sim_output, "r") as f:
    lines = f.readlines()

# Find the line index where the table header starts (usually the one starting with "Time")
header_idx = None
for i, line in enumerate(lines):
    if line.strip().startswith("Time"):
        header_idx = i
        break

if header_idx is None:
    raise ValueError("Could not find the table header (line starting with 'Time').")


# Load data into a DataFrame
df = pd.read_csv(sim_output, 
                 delim_whitespace=True, 
                 skiprows=header_idx, 
                 header=0)

df.to_excel("/Users/benhealy/Downloads/test_output.xlsx", index=False)

print("Columns found in file:")
print(df.columns.tolist())

print('Total data rows returned (timesteps):')
print(df['Time'].size)

print("extracting subset of data for plotting")
df_subset = df.iloc[2:2000]

# Example plot: Generator power vs time
plt.figure(figsize=(10,6))
plt.plot(df_subset["Time"], df_subset["GenPwr"], label="Generator Power")
plt.xlabel("Time (s)")
plt.ylabel("Power (kW)")
plt.title("Generator Power vs Time")
plt.legend()
plt.grid(True)
#plt.show()

# Another example: Rotor speed vs time
