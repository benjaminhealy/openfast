import matplotlib.ticker as ticker


# Create a function for consistent plot formatting
def format_plot(ax, xlabel, ylabel, title):
    # Set major and minor grid lines
    ax.grid(True, which='major', linestyle='-', linewidth=0.8, alpha=0.5)
    ax.grid(True, which='minor', linestyle=':', linewidth=0.5, alpha=0.2)
    
    # Customize tick spacing
    ax.xaxis.set_major_locator(ticker.MaxNLocator(10))  # Adjust number as needed
    ax.yaxis.set_major_locator(ticker.MaxNLocator(8))   # Adjust number as needed
    ax.xaxis.set_minor_locator(ticker.AutoMinorLocator())
    ax.yaxis.set_minor_locator(ticker.AutoMinorLocator())
    
    # Disable scientific notation on both axes
    ax.xaxis.set_major_formatter(ticker.ScalarFormatter(useOffset=False))
    ax.yaxis.set_major_formatter(ticker.ScalarFormatter(useOffset=False))
    ax.ticklabel_format(style='plain')
    
    # Increase font sizes
    plt.xticks(fontsize=10)
    plt.yticks(fontsize=10)
    ax.set_xlabel(xlabel, fontsize=12, labelpad=10)
    ax.set_ylabel(ylabel, fontsize=12, labelpad=10)
    ax.set_title(title, fontsize=14, pad=15)
    
    # Add padding to prevent label cutoff
    plt.tight_layout()
    


